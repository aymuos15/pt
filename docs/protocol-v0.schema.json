{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PT protocol v0 proposed event subset",
  "description": "Unreviewed WP00 draft. Validating one message does not validate framing, order, completeness, authorization, or successful work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "run_id", "generation_id", "session_id", "producer_id", "sequence", "kind", "payload"],
  "properties": {
    "protocol_version": {"const": 0},
    "run_id": {"$ref": "#/$defs/id"},
    "generation_id": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "producer_id": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "kind": {"enum": ["session_started", "item_collected", "phase_report", "collection_error", "session_terminated"]},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "session_started"},
        "payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}
      }
    },
    {
      "properties": {
        "kind": {"const": "item_collected"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["ordinal", "nodeid"],
          "properties": {
            "ordinal": {"$ref": "#/$defs/ordinal"},
            "nodeid": {"type": "string", "minLength": 1, "maxLength": 65536}
          }
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "phase_report"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["ordinal", "attempt", "phase", "outcome", "reason", "was_xfail"],
          "properties": {
            "ordinal": {"$ref": "#/$defs/ordinal"},
            "attempt": {"$ref": "#/$defs/ordinal"},
            "phase": {"enum": ["setup", "call", "teardown"]},
            "outcome": {"enum": ["passed", "failed", "skipped"]},
            "reason": {"type": ["string", "null"], "maxLength": 65536},
            "was_xfail": {"type": ["string", "null"], "maxLength": 65536}
          }
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "collection_error"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["nodeid", "reason"],
          "properties": {
            "nodeid": {"type": "string", "minLength": 1, "maxLength": 65536},
            "reason": {"type": "string", "maxLength": 65536}
          }
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "session_terminated"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["termination", "backend_exit_code"],
          "properties": {
            "termination": {"enum": ["backend_exited", "infrastructure_failed", "interrupted"]},
            "backend_exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
          },
          "allOf": [
            {
              "if": {"properties": {"termination": {"const": "backend_exited"}}},
              "then": {"properties": {"backend_exit_code": {"type": "integer"}}}
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
  }
}
