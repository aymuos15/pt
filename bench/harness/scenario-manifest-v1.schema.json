{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:pt:bench:scenario-manifest-v1",
  "title": "PT offline campaign-manifest to paired-scenario evidence binding v1",
  "description": "Full source-bound reconstruction is mandatory; no endpoint, reset, semantic, preregistration or release qualification.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "classification", "status", "confirmatory_eligible", "association_policy", "measurement_layer", "sample_unit", "declaration_consistency", "manifest", "campaign", "declaration_checks", "check_status_counts", "denominators", "session_observations", "campaign_blockers", "qualification", "statistics", "evidence", "generator", "limitations", "reconstruction_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "kind": {"const": "campaign_manifest_scenario_evidence_binding"},
    "classification": {"const": "exploratory"}, "status": {"const": "blocked"}, "confirmatory_eligible": {"type": "boolean", "const": false},
    "association_policy": {"const": "exact_declared_fields_and_whole_session_validation_only_v1"},
    "measurement_layer": {"const": "scenario_validation"}, "sample_unit": {"const": "complete_scenario_edit_replay"},
    "declaration_consistency": {"enum": ["checked_unqualified", "conflicts_found"]},
    "manifest": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256", "declaration", "frozen_structure_error_paths", "declaration_conflicts"],
      "properties": {"bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}, "sha256": {"$ref": "#/$defs/sha256"},
        "declaration": {"$ref": "urn:pt:bench:benchmark-campaign-v1"}, "frozen_structure_error_paths": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "declaration_conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "fields"],
          "properties": {"code": {"$ref": "#/$defs/text"}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}}}}},
    "campaign": {"type": "object", "additionalProperties": false, "required": ["plan", "schedule_binding", "record_consistency", "summary_status", "abort"],
      "properties": {"plan": {"$ref": "urn:pt:bench:paired-scenario-v1#/$defs/plan"}, "schedule_binding": {"$ref": "urn:pt:bench:paired-scenario-v1#/$defs/binding"},
        "record_consistency": {"enum": ["complete", "aborted"]}, "summary_status": {"enum": ["blocked", "declared_file_scenario_observations"]},
        "abort": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:paired-scenario-v1#/$defs/abort"}]}}},
    "declaration_checks": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false,
      "required": ["manifest_field", "evidence_field", "relation", "status"], "properties": {"manifest_field": {"$ref": "#/$defs/text"},
        "evidence_field": {"type": ["string", "null"], "minLength": 1}, "relation": {"enum": ["exact", "whole_session_scope_only", "execution_dispatch_budget_only", "unverified"]},
        "status": {"$ref": "#/$defs/check_status"}}}},
    "check_status_counts": {"type": "object", "propertyNames": {"$ref": "#/$defs/check_status"}, "additionalProperties": {"$ref": "#/$defs/count"}},
    "denominators": {"type": "object", "additionalProperties": false,
      "required": ["planned_session_count", "observed_session_count", "attempted_unit_calls", "known_not_called_units", "unconfirmed_unit_calls", "session_status_counts", "planned_request_count", "request_status_counts", "known_request_invocations", "unknown_request_invocations", "known_not_invoked_requests", "planned_phase_count", "phase_status_counts", "planned_file_effect_count", "file_effect_status_counts", "reset_status_counts", "known_shutdown_invocations", "unknown_shutdown_invocations", "known_not_invoked_shutdowns"],
      "properties": {"planned_session_count": {"type": "integer", "minimum": 2, "maximum": 128}, "observed_session_count": {"$ref": "#/$defs/count"},
        "attempted_unit_calls": {"$ref": "#/$defs/count"}, "known_not_called_units": {"$ref": "#/$defs/count"}, "unconfirmed_unit_calls": {"$ref": "#/$defs/count"},
        "session_status_counts": {"$ref": "#/$defs/counts"}, "planned_request_count": {"$ref": "#/$defs/count"}, "request_status_counts": {"$ref": "#/$defs/counts"},
        "known_request_invocations": {"$ref": "#/$defs/count"}, "unknown_request_invocations": {"$ref": "#/$defs/count"}, "known_not_invoked_requests": {"$ref": "#/$defs/count"},
        "planned_phase_count": {"$ref": "#/$defs/count"}, "phase_status_counts": {"$ref": "#/$defs/counts"}, "planned_file_effect_count": {"$ref": "#/$defs/count"},
        "file_effect_status_counts": {"$ref": "#/$defs/effect_counts"}, "reset_status_counts": {"$ref": "#/$defs/counts"},
        "known_shutdown_invocations": {"$ref": "#/$defs/count"}, "unknown_shutdown_invocations": {"$ref": "#/$defs/count"}, "known_not_invoked_shutdowns": {"$ref": "#/$defs/count"}}},
    "session_observations": {"type": "array", "minItems": 2, "maxItems": 128, "items": {"$ref": "#/$defs/session"}},
    "campaign_blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["context", "reasons"],
      "properties": {"context": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:paired-scenario-v1#/$defs/context"}]}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/text"}}}}},
    "qualification": {"type": "object", "required": ["complete_input_domain", "actual_loaded_code", "semantic_equal_work", "reset_equivalence", "generation_validity", "independent_units", "manifest_preregistration", "artifact_provenance", "source_environment_identities", "resource_budget_equivalence", "corpus_eligibility", "coverage_equivalence", "time_window_adequacy", "independent_review"],
      "propertyNames": {"enum": ["complete_input_domain", "actual_loaded_code", "semantic_equal_work", "reset_equivalence", "generation_validity", "independent_units", "manifest_preregistration", "artifact_provenance", "source_environment_identities", "resource_budget_equivalence", "corpus_eligibility", "coverage_equivalence", "time_window_adequacy", "independent_review"]}, "additionalProperties": {"type": "null"}},
    "statistics": {"type": "object", "additionalProperties": false, "required": ["ratio", "absolute_latency_ns", "bootstrap", "resource_observation"],
      "properties": {"ratio": {"type": "null"}, "absolute_latency_ns": {"type": "null"}, "bootstrap": {"type": "null"}, "resource_observation": {"type": "null"}}},
    "evidence": {"$ref": "#/$defs/inventory"}, "generator": {"type": "object", "additionalProperties": false, "required": ["implementation", "runtime"],
      "properties": {"implementation": {"$ref": "#/$defs/inventory"}, "runtime": {"$ref": "urn:pt:bench:result-card-v1#/properties/generator/properties/runtime"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}, "reconstruction_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/sha256"},
    "status": {"enum": ["completed_unqualified", "unsupported", "aborted", "harness_error", "not_run_campaign_aborted", "not_run_plan_changed", "unknown_unobserved", "observed_unqualified", "failed", "unknown", "not_run_prior_failure", "not_run_execution_deadline", "not_run_unsupported"]},
    "effect_status": {"enum": ["applied", "unchanged", "unknown", "not_run", "unknown_unobserved"]},
    "check_status": {"enum": ["matched_declaration", "conflicting_declaration", "unresolved_manifest_declaration", "unknown_evidence_declaration", "not_observed_by_profile"]},
    "counts": {"type": "object", "propertyNames": {"$ref": "#/$defs/status"}, "additionalProperties": {"$ref": "#/$defs/count"}},
    "effect_counts": {"type": "object", "propertyNames": {"$ref": "#/$defs/effect_status"}, "additionalProperties": {"$ref": "#/$defs/count"}},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["format", "sha256", "total_bytes", "directories", "files"],
      "properties": {"format": {"const": "sha256_canonical_scenario_manifest_inventory_v1"}, "sha256": {"$ref": "#/$defs/sha256"}, "total_bytes": {"$ref": "#/$defs/count"},
        "directories": {"type": "array", "maxItems": 512, "items": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/relative_path"}},
        "files": {"type": "array", "maxItems": 8192, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
          "properties": {"path": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/relative_path"}, "bytes": {"$ref": "#/$defs/count"}, "sha256": {"$ref": "#/$defs/sha256"}}}}}},
    "session": {"type": "object", "additionalProperties": false,
      "required": ["context", "measurement_layer", "sample_unit", "status", "unit_call_attempted", "unit_observation_returned", "receipt_record_committed", "session_record_committed", "planned_request_count", "request_status_counts", "known_request_invocations", "unknown_request_invocations", "known_not_invoked_requests", "planned_phase_count", "phase_status_counts", "planned_file_effect_count", "file_effect_status_counts", "reset_status", "reset_evidence", "shutdown_status", "shutdown_invocation_attempted", "request_observations", "failure_reasons"],
      "properties": {"context": {"$ref": "urn:pt:bench:paired-scenario-v1#/$defs/context"}, "measurement_layer": {"const": "scenario_validation"}, "sample_unit": {"const": "complete_scenario_edit_replay"},
        "status": {"$ref": "#/$defs/status"}, "unit_call_attempted": {"type": "boolean"}, "unit_observation_returned": {"type": "boolean"},
        "receipt_record_committed": {"type": "boolean"}, "session_record_committed": {"type": "boolean"}, "planned_request_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "request_status_counts": {"$ref": "#/$defs/counts"}, "known_request_invocations": {"$ref": "#/$defs/count"}, "unknown_request_invocations": {"$ref": "#/$defs/count"}, "known_not_invoked_requests": {"$ref": "#/$defs/count"},
        "planned_phase_count": {"type": "integer", "minimum": 4, "maximum": 34}, "phase_status_counts": {"$ref": "#/$defs/counts"}, "planned_file_effect_count": {"$ref": "#/$defs/count"},
        "file_effect_status_counts": {"$ref": "#/$defs/effect_counts"}, "reset_status": {"$ref": "#/$defs/status"},
        "reset_evidence": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/phase"}]}, "shutdown_status": {"$ref": "#/$defs/status"},
        "shutdown_invocation_attempted": {"type": ["boolean", "null"]}, "request_observations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/request"}},
        "failure_reasons": {"type": "array", "items": {"$ref": "#/$defs/text"}}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["id", "status", "invocation_attempted", "input_path", "expected_input", "input_delivery_status", "observed_input"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/status"}, "invocation_attempted": {"type": ["boolean", "null"]},
        "input_path": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/relative_path"}, "expected_input": {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/value"},
        "input_delivery_status": {"$ref": "#/$defs/effect_status"}, "observed_input": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/snapshot/properties/files/items"}]}}}
  }
}
