{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:pt:bench:paired-scenario-v1",
  "title": "PT paired declared-file scenario replay evidence v1",
  "description": "Correctness-instrumented file-domain observations only. Exact plans, frozen bytes, reset/edit/input observations, aborts and complete denominators require historical inspection.",
  "oneOf": [{"$ref": "#/$defs/plan"}, {"$ref": "#/$defs/session"}, {"$ref": "#/$defs/abort"}],
  "$defs": {
    "clock": {"$ref": "urn:pt:bench:resource-observation-v1#/properties/clock"},
    "binding": {"$ref": "urn:pt:bench:paired-replay-v1#/$defs/binding"}, "context": {"$ref": "urn:pt:bench:paired-replay-v1#/$defs/context"},
    "plan": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "mode", "measurement_layer", "sample_unit", "timing_endpoint", "schedule", "seed", "sessions", "workflow_sha256", "frozen_payloads", "clock_policy", "host_metadata", "limitations"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "paired_scenario_replay_campaign"}, "mode": {"const": "exploratory_unqualified"},
        "measurement_layer": {"const": "scenario_validation"}, "sample_unit": {"const": "complete_scenario_edit_replay"},
        "timing_endpoint": {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/plan/properties/timing_endpoint"}, "seed": {"type": "integer"},
        "schedule": {"$ref": "urn:pt:bench:paired-replay-v1#/$defs/plan/properties/schedule"},
        "sessions": {"type": "object", "additionalProperties": false, "required": ["baseline", "candidate"],
          "properties": {"baseline": {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/plan"}, "candidate": {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/plan"}}},
        "workflow_sha256": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/sha256"}, "frozen_payloads": {"$ref": "urn:pt:bench:result-card-v1#/$defs/inventory"},
        "clock_policy": {"const": "coordinator_process_scenario_api_calls_only"}, "host_metadata": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/host_metadata"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "session": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "mode", "context", "campaign_plan", "receipt", "call_clock", "receipt_publication_clock"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "paired_scenario_session"}, "mode": {"const": "exploratory_unqualified"},
        "context": {"$ref": "#/$defs/context"}, "campaign_plan": {"$ref": "#/$defs/binding"}, "receipt": {"$ref": "#/$defs/binding"},
        "call_clock": {"$ref": "#/$defs/clock"}, "receipt_publication_clock": {"$ref": "#/$defs/clock"}}},
    "abort": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "mode", "context", "campaign_plan", "reason", "error", "call_clock", "diagnostic_receipt", "diagnostic_session", "diagnostic_inputs"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "paired_scenario_abort"}, "mode": {"const": "exploratory_unqualified"},
        "context": {"$ref": "#/$defs/context"}, "campaign_plan": {"$ref": "#/$defs/binding"},
        "reason": {"enum": ["plan_binding_failed", "observation_error", "receipt_publication_failed", "session_validation_failed", "session_publication_failed", "session_failed"]},
        "error": {"type": "string", "minLength": 1}, "call_clock": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/clock"}]},
        "diagnostic_receipt": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:scenario-replay-v1#/$defs/receipt"}]},
        "diagnostic_session": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/session"}]},
        "diagnostic_inputs": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:result-card-v1#/$defs/inventory"}]}}}
  }
}
