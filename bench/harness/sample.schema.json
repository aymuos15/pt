{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PT exploratory paired-arm record v1",
  "description": "Prototype only: does not establish sample validity or provide the full WP01 evidence format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "block", "position", "arm", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "exploratory_unqualified"},
    "block": {"type": "integer", "minimum": 1},
    "position": {"type": "integer", "minimum": 1, "maximum": 2},
    "arm": {"enum": ["baseline", "candidate"]},
    "preparation": {"enum": ["not_requested", "recorded"]},
    "result": {"$ref": "#/$defs/result"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"status": {"const": "harness_error"}}}}},
      "else": {"required": ["preparation"]}
    }
  ],
  "$defs": {
    "argv": {
      "type": "array", "minItems": 1,
      "items": {"type": "string"},
      "prefixItems": [{"type": "string", "minLength": 1}]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "argv", "cwd", "elapsed_ns", "returncode", "output_complete",
                   "process_reaped", "stdout_bytes", "stderr_bytes", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "status": {"enum": ["exited_unqualified", "timeout"]},
        "argv": {"$ref": "#/$defs/argv"},
        "cwd": {"type": "string", "minLength": 1},
        "elapsed_ns": {"type": "integer", "minimum": 0},
        "returncode": {"type": ["integer", "null"]},
        "output_complete": {"type": "boolean"},
        "process_reaped": {"type": "boolean"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"process_reaped": {"const": true}}},
          "then": {"properties": {"returncode": {"type": "integer"}}},
          "else": {"properties": {"returncode": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "exited_unqualified"}}},
          "then": {"properties": {"process_reaped": {"const": true}, "output_complete": {"const": true}}}
        }
      ]
    },
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/measurement"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "error", "argv", "cwd", "elapsed_ns"],
          "properties": {
            "status": {"const": "launch_error"}, "error": {"type": "string"},
            "argv": {"$ref": "#/$defs/argv"}, "cwd": {"type": "string", "minLength": 1},
            "elapsed_ns": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "error"],
          "properties": {"status": {"const": "harness_error"}, "error": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "not_run_preparation_failed"}}
        }
      ]
    }
  }
}
