{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:pt:bench:scenario-replay-v1",
  "title": "PT bounded declared-file scenario/reset/edit validation v1",
  "description": "No semantic, loaded-code, external-state, cache or timing qualification. Complete reconstruction is mandatory.",
  "oneOf": [{"$ref": "#/$defs/plan"}, {"$ref": "#/$defs/unit"}, {"$ref": "#/$defs/receipt"}],
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "path": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/relative_path"},
    "clock": {"$ref": "urn:pt:bench:resource-observation-v1#/properties/clock"},
    "record_binding": {"type": "object", "additionalProperties": false, "required": ["name", "bytes", "sha256"],
      "properties": {"name": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/filename"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 3145728}, "sha256": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/sha256"}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256", "mode"],
      "properties": {"bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "sha256": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/sha256"}, "mode": {"type": "integer", "minimum": 0, "maximum": 511}}},
    "nullable_value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/value"}]},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "value"], "properties": {"path": {"$ref": "#/$defs/path"}, "value": {"$ref": "#/$defs/nullable_value"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["argv", "timeout_seconds", "guard_expectations", "required_finalization"],
      "properties": {"argv": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/argv"}, "timeout_seconds": {"type": "number", "minimum": 0.001, "maximum": 86400},
        "guard_expectations": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/nullable_guard"}, "required_finalization": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/contract", "properties": {"expected_exit_code": {"type": "integer"}}}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["id", "cache_state"],
      "properties": {"id": {"enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9"]},
        "cache_state": {"type": "object", "additionalProperties": false, "required": ["coordinator", "framework_seed", "pt_metadata", "python_bytecode", "filesystem_cache", "application_service", "dependency_observations", "source"],
          "properties": {"coordinator": {"enum": ["absent", "running", "unknown"]}, "framework_seed": {"enum": ["absent", "validated", "invalidated", "unknown"]},
            "pt_metadata": {"enum": ["absent", "populated", "invalidated", "unknown"]}, "python_bytecode": {"enum": ["absent", "valid", "controlled-invalid", "unknown"]},
            "filesystem_cache": {"enum": ["uncontrolled", "warm-procedure", "cold-procedure", "unknown"]}, "application_service": {"enum": ["absent", "fresh", "reusable-reset", "unknown"]},
            "dependency_observations": {"enum": ["absent", "trained", "invalidated", "unknown"]}, "source": {"enum": ["unchanged", "edited", "environment-changed", "unknown"]}}}}},
    "plan": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "mode", "measurement_layer", "sample_unit", "timing_endpoint", "cwd", "scenario", "input_seed", "execution_timeout_seconds", "reset", "requests", "shutdown", "limitations"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "scenario_edit_replay_plan"}, "mode": {"const": "exploratory_unqualified"},
        "measurement_layer": {"const": "scenario_validation"}, "sample_unit": {"const": "complete_scenario_edit_replay"}, "timing_endpoint": {"const": "scenario_api_entry_through_explicit_reset_edits_requests_shutdown_and_evidence_publication_v1"},
        "cwd": {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/absolute_path"}, "scenario": {"$ref": "#/$defs/scenario"}, "input_seed": {"type": "integer"},
        "execution_timeout_seconds": {"type": "number", "minimum": 0.001, "maximum": 86400},
        "reset": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/target"}},
        "requests": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "edits", "input", "command"],
          "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "input": {"$ref": "#/$defs/target", "properties": {"value": {"$ref": "#/$defs/value"}}},
            "edits": {"type": "array", "maxItems": 31, "items": {"type": "object", "additionalProperties": false, "required": ["path", "before", "after"],
              "properties": {"path": {"$ref": "#/$defs/path"}, "before": {"$ref": "#/$defs/nullable_value"}, "after": {"$ref": "#/$defs/nullable_value"}}}}, "command": {"$ref": "#/$defs/command"}}}},
        "shutdown": {"$ref": "#/$defs/command", "properties": {"timeout_seconds": {"maximum": 60}}}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["stage", "error"],
      "properties": {"stage": {"enum": ["precondition", "postcondition", "observation", "command_validation", "plan_binding", "unit_publication", "retained_input_binding"]}, "error": {"$ref": "#/$defs/text"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["clock", "files"],
      "properties": {"clock": {"$ref": "#/$defs/clock"}, "files": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "status", "value", "identity", "error"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "status": {"enum": ["present", "absent", "unknown"]}, "value": {"$ref": "#/$defs/nullable_value"},
          "identity": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer", "minimum": 0}}]}, "error": {"type": ["string", "null"], "minLength": 1}}}}}},
    "phase": {"type": "object", "additionalProperties": false,
      "required": ["index", "role", "id", "status", "clock", "before", "after", "operations", "command_invocation_attempted", "effective_timeout_seconds", "timeout_computed_at_ns", "receipt", "errors"],
      "properties": {"index": {"type": "integer", "minimum": 1, "maximum": 34}, "role": {"enum": ["reset", "transition", "request", "shutdown"]}, "id": {"$ref": "#/$defs/text"},
        "status": {"enum": ["observed_unqualified", "failed", "unknown", "not_run_prior_failure", "not_run_execution_deadline", "not_run_unsupported", "not_run_plan_changed"]},
        "clock": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/clock"}]}, "before": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]}, "after": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]},
        "operations": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "error"],
          "properties": {"path": {"$ref": "#/$defs/path"}, "status": {"enum": ["applied", "unchanged", "unknown", "not_run"]}, "error": {"type": ["string", "null"], "minLength": 1}}}},
        "command_invocation_attempted": {"type": ["boolean", "null"]}, "effective_timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 86400},
        "timeout_computed_at_ns": {"type": ["integer", "null"], "minimum": 0}, "receipt": {"oneOf": [{"type": "null"}, {"$ref": "urn:pt:bench:lifecycle-v2#/$defs/receipt"}]},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}}},
    "unit": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "plan", "phases", "retained_inputs"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "scenario_edit_replay_unit"}, "plan": {"$ref": "#/$defs/record_binding"},
        "phases": {"type": "array", "minItems": 4, "maxItems": 34, "items": {"$ref": "#/$defs/phase"}}, "retained_inputs": {"$ref": "urn:pt:bench:result-card-v1#/$defs/inventory"}}},
    "receipt": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "mode", "measurement_layer", "sample_unit", "timing_endpoint", "confirmatory_eligible", "plan", "unit", "diagnostic_unit", "clock", "plan_publication_clock", "unit_publication_clock", "status", "errors", "qualification", "limitations"],
      "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "scenario_edit_replay_receipt"}, "mode": {"const": "exploratory_unqualified"},
        "measurement_layer": {"const": "scenario_validation"}, "sample_unit": {"const": "complete_scenario_edit_replay"}, "timing_endpoint": {"$ref": "#/$defs/plan/properties/timing_endpoint"},
        "confirmatory_eligible": {"type": "boolean", "const": false}, "plan": {"$ref": "#/$defs/record_binding"}, "unit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/record_binding"}]},
        "diagnostic_unit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/unit"}]}, "clock": {"$ref": "#/$defs/clock"}, "plan_publication_clock": {"$ref": "#/$defs/clock"}, "unit_publication_clock": {"$ref": "#/$defs/clock"},
        "status": {"enum": ["completed_unqualified", "aborted", "unsupported"]}, "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
        "qualification": {"type": "object", "required": ["complete_input_domain", "actual_loaded_code", "semantic_equal_work", "reset_equivalence", "generation_validity", "independent_units"],
          "propertyNames": {"enum": ["complete_input_domain", "actual_loaded_code", "semantic_equal_work", "reset_equivalence", "generation_validity", "independent_units"]}, "additionalProperties": {"type": "null"}},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}}}
  }
}
