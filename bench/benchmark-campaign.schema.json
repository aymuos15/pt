{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PT benchmark campaign contract v1",
  "description": "Structural contract only. Frozen manifests also require semantic and artifact validation by an independent harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "campaign_id",
    "hypothesis",
    "claim_family",
    "primary_endpoint",
    "candidate",
    "baseline",
    "scenario",
    "machine",
    "experiment",
    "analysis",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "claim_family": {
      "enum": [
        "equal_work",
        "prepared_session_amortization",
        "incremental_feedback"
      ]
    },
    "primary_endpoint": {
      "enum": [
        "request_to_complete_valid_result",
        "edit_to_complete_valid_result",
        "complete_session_cost"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "binary_sha256",
        "environment_lock_sha256",
        "interpreter_sha256",
        "argv",
        "cwd",
        "reset_script_sha256",
        "state_probe_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "binary_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_lock_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpreter_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "argv": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reset_script_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_probe_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "binary_sha256",
        "environment_lock_sha256",
        "interpreter_sha256",
        "argv",
        "cwd",
        "reset_script_sha256",
        "state_probe_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "binary_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_lock_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpreter_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "argv": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reset_script_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_probe_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "source_revision",
        "scope",
        "contract_id",
        "workers",
        "cache_state",
        "generation_assurance",
        "coverage",
        "coverage_config_sha256",
        "expected_inventory_sha256",
