        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "full",
            "explicit_selection",
            "affected"
          ]
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "cache_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coordinator",
            "framework_seed",
            "pt_metadata",
            "python_bytecode",
            "filesystem_cache",
            "application_service",
            "dependency_observations",
            "source"
          ],
          "properties": {
            "coordinator": {
              "enum": [
                "absent",
                "running"
              ]
            },
            "framework_seed": {
              "enum": [
                "absent",
                "validated",
                "invalidated"
              ]
            },
            "pt_metadata": {
              "enum": [
                "absent",
                "populated",
                "invalidated"
              ]
            },
            "python_bytecode": {
              "enum": [
                "absent",
                "valid",
                "controlled-invalid"
              ]
            },
            "filesystem_cache": {
              "enum": [
                "uncontrolled",
                "warm-procedure",
                "cold-procedure"
              ]
            },
            "application_service": {
              "enum": [
                "absent",
                "fresh",
                "reusable-reset"
              ]
            },
            "dependency_observations": {
              "enum": [
                "absent",
                "trained",
                "invalidated"
              ]
            },
            "source": {
              "enum": [
                "unchanged",
                "edited",
                "environment-changed"
              ]
            }
          }
        },
        "generation_assurance": {
          "enum": [
            "immutable_snapshot",
            "live_tree_observed"
          ]
        },
        "coverage": {
          "enum": [
            "none",
            "line",
            "branch",
            "contexts"
          ]
        },
        "coverage_config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_inventory_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_outcome_artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "output_profile": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reset_policy_document_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_cost_inside_timer": {
          "type": "boolean"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_sha256",
        "cpu_budget",
        "memory_budget_bytes",
        "native_library_threads",
        "accounting_scope",
        "memory_metric"
      ],
      "properties": {
        "profile_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_budget": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_budget_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "native_library_threads": {
          "type": "integer",
          "minimum": 1
        },
        "accounting_scope": {
          "const": "all_owned_processes_and_persistent_services"
        },
        "memory_metric": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paired_blocks",
        "minimum_time_windows",
        "order",
        "random_seed",
        "sample_unit",
        "analysis_unit",
        "warmup_policy",
        "timeout_seconds",
        "exclusion_policy_sha256",
        "pilot_report_sha256",
        "fixed_sample_count_before_confirmation"
      ],
      "properties": {
        "paired_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_time_windows": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "const": "balanced_randomized"
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "sample_unit": {
          "enum": [
            "complete_invocation",
            "complete_session_replay"
          ]
        },
        "analysis_unit": {
          "enum": [
            "independent_paired_block",
            "independent_paired_session"
          ]
        },
        "warmup_policy": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "exclusion_policy_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pilot_report_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_sample_count_before_confirmation": {
          "const": true
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_estimator",
        "ratio_direction",
        "confidence_level",
        "resampling_unit",
        "bootstrap_resamples",
        "bootstrap_seed",
        "dependence_review_required",
        "practical_relative_gain",
        "practical_absolute_gain_seconds",
        "multiplicity_policy",
        "analysis_code_sha256"
      ],
      "properties": {
        "primary_estimator": {
          "const": "exp_mean_paired_log_ratio"
        },
        "ratio_direction": {
          "const": "baseline_over_candidate"
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "resampling_unit": {
          "enum": [
            "independent_paired_block",
            "independent_paired_session",
            "higher_level_cluster"
          ]
        },
        "bootstrap_resamples": {
          "type": "integer",
          "minimum": 10000
        },
        "bootstrap_seed": {
          "type": "integer",
          "minimum": 0
        },
        "dependence_review_required": {
          "const": true
        },
        "practical_relative_gain": {
          "type": "number",
          "minimum": 0
        },
        "practical_absolute_gain_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "multiplicity_policy": {
          "type": "string",
          "minLength": 1
        },
        "analysis_code_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_correctness_qualification",
        "preserve_failed_and_excluded_samples",
        "publish_eligible_and_total_denominators",
        "include_idle_memory_and_session_cost",
        "allow_confirmatory_with_unresolved_fields"
      ],
      "properties": {
        "require_correctness_qualification": {
          "const": true
        },
        "preserve_failed_and_excluded_samples": {
          "const": true
        },
        "publish_eligible_and_total_denominators": {
          "const": true
        },
        "include_idle_memory_and_session_cost": {
          "const": true
        },
        "allow_confirmatory_with_unresolved_fields": {
          "const": false
        }
      }
    }
